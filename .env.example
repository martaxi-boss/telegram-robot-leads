# Copie para .env e preencha. Nunca commitar .env com valores reais.
# Sessões Telethon (*.session) e accounts.json ficam fora do Git.

# --- API Telegram (obrigatório) ---
# https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Alternativas: API_ID / API_HASH
# Ou ficheiro JSON: telegram_api.json / TELEGRAM_CREDENTIALS_FILE
# TELEGRAM_CREDENTIALS_FILE=telegram_api.json

# Par público do cliente Android OSS (só se my.telegram.org falhar)
# TELEGRAM_USE_PUBLISHED_ANDROID_API=0

# --- Contas (accounts.json ou JSON inline) ---
# TELEGRAM_ACCOUNTS_JSON=[{"session":"conta1","phone":"+351..."}]

# --- Grupo alvo ---
TARGET_GROUP=@iptvpncode

# --- Regiões por conta (conta1=PT+ES, conta2=Europa) ---
# TELEGRAM_REGION_SPLIT=1
# TELEGRAM_ACCOUNT_REGIONS=pt_es,europe

# --- Ritmo / limites ---
MIN_ADDS_PER_DAY=45
MAX_ADDS_PER_DAY=80
MAX_ADDS_PROJECT_PER_DAY=70

# --- Modos de operação (1/0, true/false, yes/no) ---
TELEGRAM_INVITES_ENABLED=1
SCRAPE_ENABLED=1
SCRAPE_ALL_ACCOUNTS=0
SCRAPE_EXTRA_ACCOUNTS_ALSO_GLOBAL=0
EXCLUDE_SOURCE_GROUP_ADMINS=1
TELEGRAM_ACTIVE_MODE=0
TELEGRAM_SCRAPE_RELAX_NAME_FILTER=0
TELEGRAM_INVITE_NEWEST_FIRST=1

# --- Scrape / fila ---
TELEGRAM_SEARCH_LIMIT=25
TELEGRAM_SCRAPE_MAX_PER_GROUP=500
QUEUE_EMPTY_WAIT_SEC=90
# TELEGRAM_FIXED_SCRAPE_GROUPS=grupo1,grupo2
# TELEGRAM_PRIORITY_SCRAPE_GROUPS=
# TELEGRAM_INVITES_DISABLED_SESSIONS=conta2
# TELEGRAM_INVITE_COOLDOWN_UNTIL=2026-01-01T00:00:00

# --- SQLite / processo ---
SQLITE_BUSY_TIMEOUT=30
STALE_PROCESSING_SEC=2700
DOTENV_OVERRIDE=0

# --- Logs / sistema ---
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
DISK_WARN_FREE_MB=400
WORKER_LOGIN_STAGGER_SEC=45
TELEGRAM_START_TIMEOUT_SEC=300
TELEGRAM_INVITE_PAUSE_FACTOR=1.0
INVITES_OFF_HEARTBEAT_SEC=1800
