# Telegram Robot Leads - current safe runtime
# EXAMPLE ONLY: never commit real credentials or overwrite the existing VPS vault.
# Canonical protected vault: /root/project-secrets/telegram-robot-leads/
# Its existing accounts.json and two *.session files must be preserved.
# The service requires private, application-owned Telegram API credentials.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TARGET_GROUP=@iptvpncode

# Optional filenames inside the protected vault; both must be owner-only (0600).
# The worker can automatically discover PUBLIC group usernames and titles.
# It does not enumerate members or auto-enroll discovered users.
# discovery_keywords.txt: optional private topic list in this vault (0600);
# defaults to "iptv portugal" and "iptv" for this existing IPTV target.
# group_allowlist.txt: public group usernames explicitly selected by the operator
# approved_users.txt: one username|APPROVED or username|CONSENTED per line
# Discovery also works via the public target URL without a BotFather token.
TELEGRAM_GROUP_ALLOWLIST=group_allowlist.txt
TELEGRAM_APPROVED_USERS=approved_users.txt

# Durable fail-closed state is stored outside the Git checkout and secret vault.
TELEGRAM_OPERATION_STATE=/var/lib/telegram-robot-leads/operation-state.json
TELEGRAM_TZ=Europe/Lisbon

# Limits are defined and enforced by scripts/operation_policy.py (not by legacy
# environment overrides). Review before making any external membership action.
# Do not set legacy SCRAPE_*, MIN_ADDS_*, MAX_ADDS_* or mimicry settings.
